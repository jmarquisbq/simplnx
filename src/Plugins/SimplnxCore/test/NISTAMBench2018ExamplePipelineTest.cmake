include("${CMAKE_CURRENT_LIST_DIR}/../../../../cmake/RunExamplePipelineChain.cmake")
set(OUTPUT_CATEGORY "NIST_AMBench_2018_Examples")
set(pipeline_stems
  "(01) NIST Bridge Contour Inspection"
  "(02) NIST Bridge Part Export"
  "(03) NIST Bridge STL Assembly"
)
foreach(stem IN LISTS pipeline_stems)
  validate_companion("${EXAMPLE_DIR}/${stem}.d3dpipeline")
endforeach()
prepare_example_workspace()
file(REAL_PATH "${WORK_DIR}" work_root)
set(data_dir "${work_root}/Data/${OUTPUT_CATEGORY}")
file(MAKE_DIRECTORY "${data_dir}")
file(REAL_PATH "${data_dir}" resolved_data_dir)
cmake_path(IS_PREFIX work_root "${resolved_data_dir}" NORMALIZE data_inside)
if(NOT data_inside)
  message(FATAL_ERROR "Input staging directory must stay in the test workspace: ${resolved_data_dir}")
endif()

get_filename_component(runtime_dir "${NXRUNNER}" DIRECTORY)
file(READ "${EXAMPLE_DIR}/DataSources.json" sources)
string(JSON file_count LENGTH "${sources}" files)
if(NOT file_count EQUAL 1)
  message(FATAL_ERROR "Expected the one original NIST single-part STL")
endif()
string(JSON filename GET "${sources}" files 0 filename)
string(JSON url GET "${sources}" files 0 url)
string(JSON expected_hash GET "${sources}" files 0 sha512)
if(NOT filename STREQUAL "AMB2018_01_Part.STL")
  message(FATAL_ERROR "Unexpected NIST input filename: ${filename}")
endif()
set(input_path "${resolved_data_dir}/${filename}")
set(cache_path "${runtime_dir}/Data/${OUTPUT_CATEGORY}/${filename}")
if(IS_SYMLINK "${input_path}")
  message(FATAL_ERROR "Input staging path must not be a symbolic link: ${input_path}")
endif()
if(EXISTS "${input_path}")
  file(SHA512 "${input_path}" actual_hash)
  if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Staged input checksum mismatch: ${input_path}")
  endif()
elseif(EXISTS "${cache_path}")
  file(SHA512 "${cache_path}" actual_hash)
  if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Cached input checksum mismatch: ${cache_path}")
  endif()
  file(COPY_FILE "${cache_path}" "${input_path}")
else()
  set(download_path "${input_path}.download")
  if(IS_SYMLINK "${download_path}" OR IS_DIRECTORY "${download_path}")
    message(FATAL_ERROR "Unsafe temporary input path: ${download_path}")
  endif()
  file(DOWNLOAD "${url}" "${download_path}"
    EXPECTED_HASH "SHA512=${expected_hash}" TLS_VERIFY ON TIMEOUT 120)
  file(RENAME "${download_path}" "${input_path}")
endif()
set(pipeline_stems "(01) NIST Bridge Contour Inspection" "(02) NIST Bridge Part Export")
run_example_pipeline_chain()

# The directory reader imports every STL, so reject unrelated files before it runs.
set(parts_directory "${work_root}/Data/Output/${OUTPUT_CATEGORY}/Parts")
file(GLOB part_entries LIST_DIRECTORIES FALSE "${parts_directory}/*")
set(actual_part_names "")
foreach(entry IN LISTS part_entries)
  get_filename_component(extension "${entry}" EXT)
  string(TOLOWER "${extension}" extension)
  if(extension STREQUAL ".stl")
    get_filename_component(filename "${entry}" NAME)
    list(APPEND actual_part_names "${filename}")
  endif()
endforeach()
list(SORT actual_part_names)
set(expected_part_names "Part01.stl;Part02.stl;Part03.stl;Part04.stl")
if(NOT "${actual_part_names}" STREQUAL "${expected_part_names}")
  message(FATAL_ERROR "Expected only the four generated NIST part files in ${parts_directory}; found: ${actual_part_names}")
endif()
set(pipeline_stems "(03) NIST Bridge STL Assembly")
run_example_pipeline_chain()
