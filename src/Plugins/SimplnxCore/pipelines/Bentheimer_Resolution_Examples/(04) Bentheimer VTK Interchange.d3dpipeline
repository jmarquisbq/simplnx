      "args": {
        "output_type_index": {
          "value": 0,
          "version": 1
        },
        "selected_image_geom_path": {
          "value": "VTKImportedROI",
          "version": 1
        },
        "coords_array_path": {
          "value": "VTKImportedROI/CellData/CoordinatesMicrometers",
          "version": 1
        },
        "indices_array_path": {
          "value": "VTKImportedROI/CellData/UnusedIndices",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Reconstruct cell-center positions from the imported header geometry. Micrometers come from this example's provenance, not a unit declaration in the VTK file.",
