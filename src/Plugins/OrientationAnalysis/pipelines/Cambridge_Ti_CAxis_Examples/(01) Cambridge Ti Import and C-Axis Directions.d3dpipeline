        "name": "nx::core::CopyDataObjectFilter",
        "uuid": "ac8d51d8-9167-5628-a060-95a8863a76b1"
      },
      "isDisabled": false
    },
    {
      "args": {
        "source_data_object_path": {
          "value": "Titanium/Cell Data/Phases_Analysis",
          "version": 1
        },
        "new_name": {
          "value": "AnalysisPhases",
          "version": 1
        },
        "allow_overwrite": {
          "value": false,
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Name the copied phase array AnalysisPhases.",
      "filter": {
        "name": "nx::core::RenameDataObjectFilter",
        "uuid": "911a3aa9-d3c2-4f66-9451-8861c4b726d5"
      },
      "isDisabled": false
    },
    {
      "args": {
        "use_conditional": {
          "value": true,
