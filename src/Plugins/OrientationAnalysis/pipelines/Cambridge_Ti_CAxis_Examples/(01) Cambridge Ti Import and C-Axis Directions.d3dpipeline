        "replace_value": {
          "value": "0",
          "version": 1
        },
        "selected_array_path": {
          "value": "Titanium/Cell Data/AnalysisPhases",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Set excluded analysis phases to zero; keep raw Phases unchanged.",
      "filter": {
        "name": "nx::core::ConditionalSetValueFilter",
        "uuid": "bad9b7bd-1dc9-4f21-a889-6520e7a41881"
      },
      "isDisabled": false
    },
    {
      "args": {
        "input_representation_index": {
          "value": 0,
          "version": 1
        },
        "output_representation_index": {
          "value": 2,
          "version": 1
        },
        "input_orientation_array_path": {
          "value": "Titanium/Cell Data/EulerAngles",
          "version": 1
        },
        "output_orientation_array_name": {
          "value": "Quats",
          "version": 1
        },
        "parameters_version": 1
      },
