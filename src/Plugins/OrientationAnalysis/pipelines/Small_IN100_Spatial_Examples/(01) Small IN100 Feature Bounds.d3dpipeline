          "version": 1
        },
        "invert_mask": {
          "value": true,
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Set all six components of excluded rows to zero. These finite zero-size boxes contain no cells and safely replace raw NaNs/background bounds for statistics.",
      "filter": {
        "name": "nx::core::ConditionalSetValueFilter",
        "uuid": "bad9b7bd-1dc9-4f21-a889-6520e7a41881"
