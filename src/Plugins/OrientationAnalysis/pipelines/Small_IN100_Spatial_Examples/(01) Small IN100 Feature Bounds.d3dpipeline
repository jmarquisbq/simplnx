          "value": "OccupiedPositiveFeatures",
          "version": 1
        },
        "use_custom_false_value": {
          "value": false,
          "version": 1
        },
        "use_custom_true_value": {
          "value": false,
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Select NumElements > 0. The measurements predecessor leaves row 0 at zero even though background cells exist; this mask excludes background and all unused positive labels.",
