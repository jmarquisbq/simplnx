        "name": "nx::core::ComputeFeatureBoundsFilter",
        "uuid": "b0616957-d051-4e51-bf27-efb742848fc9"
      },
      "isDisabled": false
    },
    {
      "args": {
        "array_thresholds_object": {
          "value": {
            "inverted": false,
            "thresholds": [
              {
                "array_path": "DataContainer/Cell Feature Data/NumElements",
                "comparison": 0,
                "component_index": 0,
                "inverted": false,
                "type": "array",
                "union": 0,
                "value": 0.0
              }
