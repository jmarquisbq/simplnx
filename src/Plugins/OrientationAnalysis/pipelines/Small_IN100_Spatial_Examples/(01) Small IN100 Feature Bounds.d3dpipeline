          "value": "FeatureIndexBounds",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Find inclusive minXYZ/maxXYZ cell indices per original positive FeatureId. Row 0 and absent labels retain UINT32_MAX minima and zero maxima.",
      "filter": {
        "name": "nx::core::ComputeFeatureRectFilter",
        "uuid": "bf947c45-8610-44c9-917a-405e88f73fe7"
      },
