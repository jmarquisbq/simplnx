          "version": 1
        },
        "feature_phases_array_path": {
          "value": "Small IN100/Grain Data/Phases",
          "version": 1
        },
        "input_triangle_geometry_path": {
          "value": "BoundaryMesh",
          "version": 1
        },
        "misorientation_rotation": {
          "value": [
            1.0,
            1.0,
            1.0,
            60.0
          ],
          "version": 1
        },
        "node_types_array_path": {
          "value": "BoundaryMesh/VertexData/NodeType",
          "version": 1
        },
        "num_sampl_pts": {
          "value": 3000,
          "version": 1
        },
        "parameters_version": 1,
        "phase_of_interest": {
          "value": 1,
          "version": 1
        },
        "save_relative_err": {
          "value": false,
          "version": 1
        },
        "surface_mesh_face_areas_array_path": {
          "value": "BoundaryMesh/Face Data/FaceAreas",
          "version": 1
        },
        "surface_mesh_face_labels_array_path": {
          "value": "BoundaryMesh/Face Data/FaceLabels",
          "version": 1
        },
        "surface_mesh_face_normals_array_path": {
          "value": "BoundaryMesh/Face Data/FaceNormals",
          "version": 1
        },
        "surface_mesh_feature_face_labels_array_path": {
          "value": "TriangleDataContainer/FaceFeatureData/FaceLabels",
          "version": 1
        }
      },
      "comments": "Probe Sigma3 using the metric method with 3-degree misorientation and 7-degree plane radii, matching the paper radius choice but on this different prepared network. Input order differs from the binned filters: axis then angle [1,1,1,60]. Keep triple-line triangles for the same baseline population. Save absolute sampling errors, not confidence in physical reconstruction.",
      "filter": {
        "name": "nx::core::ComputeGBCDMetricBasedFilter",
        "uuid": "fc0d695a-e381-4f11-a8fd-26d5b5cda30a"
      },
      "isDisabled": false
    },
    {
      "args": {
        "crystal_structures_array_path": {
          "value": "Small IN100/Phase Data/CrystalStructures",
          "version": 1
        },
        "dist_output_file": {
          "value": "Data/Output/Small_IN100_Distribution_Examples/PlaneDistribution_1.dat",
          "version": 1
        },
        "err_output_file": {
          "value": "Data/Output/Small_IN100_Distribution_Examples/PlaneDistributionErrors_1.dat",
          "version": 1
        },
        "exclude_triple_lines": {
          "value": false,
          "version": 1
        },
