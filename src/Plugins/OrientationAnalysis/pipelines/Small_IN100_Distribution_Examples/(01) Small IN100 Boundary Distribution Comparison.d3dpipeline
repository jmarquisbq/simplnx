          "value": "Small IN100/Grain Data/AvgEulerAngles",
          "version": 1
        },
        "feature_phases_array_path": {
          "value": "Small IN100/Grain Data/Phases",
          "version": 1
        },
        "input_triangle_geometry_path": {
          "value": "BoundaryMesh",
          "version": 1
        },
        "limit_dist": {
          "value": 7.0,
          "version": 1
        },
        "node_types_array_path": {
          "value": "BoundaryMesh/VertexData/NodeType",
          "version": 1
        },
        "num_sampl_pts": {
          "value": 3000,
          "version": 1
        },
        "parameters_version": 1,
        "phase_of_interest": {
          "value": 1,
          "version": 1
        },
        "save_relative_err": {
          "value": false,
          "version": 1
        },
        "surface_mesh_face_areas_array_path": {
          "value": "BoundaryMesh/Face Data/FaceAreas",
          "version": 1
        },
        "surface_mesh_face_labels_array_path": {
          "value": "BoundaryMesh/Face Data/FaceLabels",
          "version": 1
        },
        "surface_mesh_face_normals_array_path": {
          "value": "BoundaryMesh/Face Data/FaceNormals",
          "version": 1
        },
        "surface_mesh_feature_face_labels_array_path": {
          "value": "TriangleDataContainer/FaceFeatureData/FaceLabels",
          "version": 1
        }
      },
      "comments": "Compute the marginal boundary-plane distribution with a 7-degree cap over all eligible same-phase boundaries, without fixing a misorientation. This is not another Sigma3 section. Retain triple-line triangles consistently and use the verified original unique-pair table, not the triangle count, for error estimates.",
      "filter": {
        "name": "nx::core::ComputeGBPDMetricBasedFilter",
        "uuid": "8267878b-d23a-4666-83a0-f1a7711861ce"
      },
      "isDisabled": false
    },
    {
      "args": {
        "compression_level": {
          "value": 5,
          "version": 1
        },
        "export_file_path": {
          "value": "Data/Output/Small_IN100_Distribution_Examples/SmallIN100BoundaryDistributions.dream3d",
          "version": 1
        },
        "parameters_version": 2,
        "use_compression": {
          "value": true,
          "version": 1
        },
        "write_xdmf_file": {
          "value": false,
          "version": 1
        }
      },
      "comments": "Save source context, validated reduced mesh, binned GBCD and its stereographic section. Metric methods produce named text files alongside this checkpoint. No original paper peak, material acceptance threshold, or physical-area calibration is claimed.",
      "filter": {
        "name": "nx::core::WriteDREAM3DFilter",
        "uuid": "b3a95784-2ced-41ec-8d3d-0242ac130003"
      },
      "isDisabled": false
    }
  ],
