{
  "isDisabled": false,
  "name": "(01) Small IN100 Boundary Distribution Comparison.d3dpipeline",
  "pinnedParams": [],
  "pipeline": [
    {
      "args": {
        "import_data_object": {
          "value": {
            "file_path": "Data/Small_IN100_Distribution_Examples/compute_gbcd_metric_based.dream3d",
            "data_paths": [],
            "path_import_policy": 0
          },
          "version": 2
        },
        "parameters_version": 1
      },
      "comments": "Read the SHA-pinned public Small IN100 processed mesh and its original feature/pair tables. This is an existing prepared network, not a fresh reconstruction or proof of identity with the paper mesh. Retain the imported data for comparison; physical calibration must be established separately from normalized distribution weights.",
      "filter": {
        "name": "nx::core::ReadDREAM3DFilter",
        "uuid": "0dbd31c7-19e0-4077-83ef-f4a6459a0e2d"
      },
      "isDisabled": false
    },
    {
      "args": {
        "array_thresholds_object": {
          "value": {
            "inverted": false,
            "thresholds": [
              {
                "array_path": "TriangleDataContainer/FaceData/FaceAreas",
                "comparison": 2,
                "component_index": 0,
                "inverted": false,
                "type": "array",
                "union": 0,
                "value": 0.0
              }
            ],
            "type": "collection",
            "union": 0
          },
          "version": 2
        },
        "created_mask_type": {
          "value": 1,
          "version": 1
        },
        "custom_false_value": {
          "value": 0.0,
          "version": 1
        },
        "custom_true_value": {
          "value": 1.0,
          "version": 1
        },
        "output_data_array_name": {
          "value": "ZeroAreaFaces",
          "version": 1
        },
        "use_custom_false_value": {
          "value": false,
          "version": 1
        },
        "use_custom_true_value": {
          "value": false,
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Mark the 12 zero-area source triangles. Their normals are undefined; the mask is a geometric validity check, not a minimum-area cutoff or removal of small physical boundaries.",
      "filter": {
        "name": "nx::core::MultiThresholdObjectsFilter",
        "uuid": "4246245e-1011-4add-8436-0af6bed19228"
      },
      "isDisabled": false
    },
    {
      "args": {
        "input_triangle_geometry_path": {
          "value": "TriangleDataContainer",
          "version": 1
        },
        "mask_array_path": {
          "value": "TriangleDataContainer/FaceData/ZeroAreaFaces",
          "version": 1
        },
        "output_triangle_geometry_path": {
          "value": "BoundaryMesh",
          "version": 1
        },
        "parameters_version": 1,
        "triangle_data_handling_index": {
          "value": 0,
          "version": 1
        },
        "triangle_data_selected_array_paths": {
          "value": [
            "TriangleDataContainer/FaceData/FaceLabels",
            "TriangleDataContainer/FaceData/FeatureFaceId"
          ],
          "version": 1
        },
        "triangle_data_selected_attribute_matrix_path": {
          "value": "",
          "version": 1
        },
        "vertex_data_handling_index": {
          "value": 0,
          "version": 1
        },
        "vertex_data_selected_array_paths": {
          "value": [
            "TriangleDataContainer/VertexData/NodeType"
          ],
          "version": 1
        },
        "vertex_data_selected_attribute_matrix_path": {
          "value": "",
          "version": 1
        }
      },
      "comments": "Remove only degenerate triangles and compact vertices, transferring paired grain labels, original interface ID, and node types. All 4224 internal grain pairs remain represented; the supplied unique-pair table remains valid for metric uncertainty counts. Recompute areas and normals after geometry selection.",
      "filter": {
        "name": "nx::core::RemoveFlaggedTrianglesFilter",
        "uuid": "38155c61-2709-4731-be95-43745bb3f8d8"
      },
      "isDisabled": false
    },
    {
      "args": {
        "input_triangle_geometry_path": {
          "value": "BoundaryMesh",
          "version": 1
        },
        "parameters_version": 1,
        "triangle_areas_array_name": {
          "value": "FaceAreas",
          "version": 1
        }
      },
      "comments": "Recompute nonzero triangle areas from the retained geometry. MRD normalization uses relative area weights; a common length-scale factor cancels. Do not interpret source numeric coordinates as calibrated meters from the imported default unit tag.",
      "filter": {
        "name": "nx::core::ComputeTriangleAreasFilter",
        "uuid": "b149addd-c0c8-4010-a264-596005eaf2a5"
      },
      "isDisabled": false
    },
    {
      "args": {
        "input_triangle_geometry_path": {
          "value": "BoundaryMesh",
          "version": 1
        },
        "output_normals_array_name": {
          "value": "FaceNormals",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Recompute finite unit normals from the same triangle winding and retained vertices. Preserve the correspondence between normals and the two face labels; arbitrary normal/label changes can alter crystallographic interpretation.",
      "filter": {
        "name": "nx::core::TriangleNormalFilter",
        "uuid": "8133d419-1919-4dbf-a5bf-1c97282ba63f"
      },
      "isDisabled": false
    },
    {
      "args": {
        "crystal_structures_array_path": {
          "value": "Small IN100/Phase Data/CrystalStructures",
          "version": 1
        },
        "face_ensemble_attribute_matrix_name": {
          "value": "Face Ensemble Data",
          "version": 1
        },
        "feature_euler_angles_array_path": {
          "value": "Small IN100/Grain Data/AvgEulerAngles",
          "version": 1
        },
        "feature_phases_array_path": {
          "value": "Small IN100/Grain Data/Phases",
          "version": 1
        },
        "gbcd_array_name": {
          "value": "GBCD",
          "version": 1
        },
        "gbcd_resolution": {
          "value": 10.0,
          "version": 1
        },
        "input_triangle_geometry_path": {
          "value": "BoundaryMesh",
          "version": 1
        },
        "parameters_version": 1,
        "surface_mesh_face_areas_array_path": {
          "value": "BoundaryMesh/Face Data/FaceAreas",
          "version": 1
        },
        "surface_mesh_face_labels_array_path": {
          "value": "BoundaryMesh/Face Data/FaceLabels",
          "version": 1
        },
        "surface_mesh_face_normals_array_path": {
          "value": "BoundaryMesh/Face Data/FaceNormals",
          "version": 1
        }
      },
      "comments": "Compute the area-weighted binned five-parameter distribution for the retained same-phase internal boundaries. Resolution 10 degrees follows the paper nominal coarse-bin comparison scale; the native partition is not a uniform angular neighborhood or a claim of identical paper bins. More bins require more independent boundary data; mesh triangles are not independent grain boundaries.",
      "filter": {
        "name": "nx::core::ComputeGBCDFilter",
        "uuid": "0cc592b7-a3d3-4c6a-8894-1533670a31b9"
      },
      "isDisabled": false
    },
    {
      "args": {
        "cell_attribute_matrix_name": {
          "value": "Cell Data",
          "version": 1
        },
        "cell_intensity_array_name": {
          "value": "MRD",
          "version": 1
        },
        "crystal_structures_array_path": {
          "value": "Small IN100/Phase Data/CrystalStructures",
          "version": 1
        },
        "gbcd_array_path": {
          "value": "BoundaryMesh/Face Ensemble Data/GBCD",
          "version": 1
        },
        "misorientation_rotation": {
          "value": [
            60.0,
            1.0,
            1.0,
            1.0
          ],
          "version": 1
        },
        "output_image_dimension": {
          "value": 128,
          "version": 1
        },
        "output_image_geometry_path": {
          "value": "BinnedSigma3Section",
          "version": 1
        },
        "parameters_version": 1,
        "phase_of_interest": {
          "value": 1,
          "version": 1
        }
      },
      "comments": "Probe the binned distribution at the Sigma3 misorientation: angle first, [60,1,1,1]. The 128-pixel stereographic grid is a display sampling choice, not extra experimental resolution. Its coordinates are dimensionless projection coordinates despite the current image unit metadata.",
      "filter": {
        "name": "nx::core::ComputeGBCDPoleFigureFilter",
        "uuid": "eed5183e-5a9c-485b-9e64-579a81f0d301"
      },
      "isDisabled": false
    },
    {
      "args": {
        "crystal_structures_array_path": {
          "value": "Small IN100/Phase Data/CrystalStructures",
          "version": 1
        },
        "gbcd_array_path": {
          "value": "BoundaryMesh/Face Ensemble Data/GBCD",
          "version": 1
        },
        "misorientation_rotation": {
          "value": [
            60.0,
            1.0,
            1.0,
            1.0
          ],
          "version": 1
        },
        "output_file": {
          "value": "Data/Output/Small_IN100_Distribution_Examples/BinnedSigma3.dat",
          "version": 1
        },
        "parameters_version": 1,
        "phase_of_interest": {
          "value": 1,
          "version": 1
        }
      },
      "comments": "Export the same fixed-misorientation binned section on the writer sampling grid. Input is angle-axis [60,1,1,1]; the text header writes axis-angle. Use actual angular coordinates rather than assuming text rows correspond to image pixels.",
      "filter": {
        "name": "nx::core::WriteGBCDGMTFileFilter",
        "uuid": "31710abf-b8a6-423f-a03f-4b8885bd3633"
      },
      "isDisabled": false
    },
    {
      "args": {
        "feature_euler_angles_array_path": {
          "value": "Small IN100/Grain Data/AvgEulerAngles",
          "version": 1
        },
        "output_file": {
          "value": "Data/Output/Small_IN100_Distribution_Examples/InternalBoundaryTriangles.ph",
          "version": 1
        },
        "parameters_version": 1,
        "surface_mesh_face_areas_array_path": {
          "value": "BoundaryMesh/Face Data/FaceAreas",
          "version": 1
        },
        "surface_mesh_face_labels_array_path": {
          "value": "BoundaryMesh/Face Data/FaceLabels",
          "version": 1
        },
        "surface_mesh_face_normals_array_path": {
          "value": "BoundaryMesh/Face Data/FaceNormals",
          "version": 1
        }
      },
      "comments": "Export retained positive-label internal triangles with both grain orientations, face normal and area for independent boundary-analysis tools. Areas are in the source coordinate scale squared, whose absolute physical calibration is not established by this converted fixture. Preserve the matching Euler/normal reference convention.",
      "filter": {
        "name": "nx::core::WriteGBCDTriangleDataFilter",
        "uuid": "6e0da3a1-dc42-4b01-80aa-3af9e8209ee3"
      },
      "isDisabled": false
    },
    {
      "args": {
        "chosen_limit_dists_index": {
          "value": 0,
          "version": 1
        },
        "crystal_structures_array_path": {
          "value": "Small IN100/Phase Data/CrystalStructures",
          "version": 1
        },
        "dist_output_file": {
          "value": "Data/Output/Small_IN100_Distribution_Examples/MetricSigma3_1.dat",
          "version": 1
        },
        "err_output_file": {
          "value": "Data/Output/Small_IN100_Distribution_Examples/MetricSigma3Errors_1.dat",
          "version": 1
        },
        "exclude_triple_lines": {
          "value": false,
          "version": 1
        },
        "feature_euler_angles_array_path": {
