          "version": 1
        },
        "init_end_range": {
          "value": "1",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Record zero-based acquisition tuple identity 0..28085 as uint32 before cropping. X varies fastest, so SourceScanIndex = y * 186 + x for this scan.",
      "filter": {
