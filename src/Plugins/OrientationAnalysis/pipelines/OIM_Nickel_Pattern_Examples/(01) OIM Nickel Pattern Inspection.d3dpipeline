          "value": 2,
          "version": 1
        },
        "header_option_index": {
          "value": 1,
          "version": 1
        },
        "input_data_array_paths": {
          "value": [
            "Selected Patterns/Cell Data/SourceScanIndex",
            "Selected Patterns/Cell Data/Confidence Index",
            "Selected Patterns/Cell Data/Image Quality",
            "Selected Patterns/Cell Data/Fit"
          ],
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Export both selected rows, including tuple zero, in the same order as Pattern.bin: source tuple index, Confidence Index, Image Quality, and Fit. Recover acquisition-grid x=index%186 and y=index//186; these are grid indices, not detector-pixel or physical coordinates. These metrics do not establish indexing validity.",
      "filter": {
        "name": "nx::core::WriteASCIIDataFilter",
        "uuid": "06c8bfe8-2b42-4956-aca3-580bc0620716"
      },
      "isDisabled": false
    },
    {
