include("${CMAKE_CURRENT_LIST_DIR}/../../../../cmake/RunExamplePipelineChain.cmake")
set(OUTPUT_CATEGORY "Gille_Aluminum_LabDCT_Examples")
set(pipeline_stems "(01) Gille Aluminum LabDCT Preparation")
validate_companion("${EXAMPLE_DIR}/${pipeline_stems}.d3dpipeline")
get_filename_component(runtime_dir "${NXRUNNER}" DIRECTORY)
if(NOT DEFINED RAW_DATA_FILE OR "${RAW_DATA_FILE}" STREQUAL "")
  set(RAW_DATA_FILE "${runtime_dir}/Data/${OUTPUT_CATEGORY}/sample_S_undeformed_6_grain_center_slice.h5")
  if(NOT EXISTS "${RAW_DATA_FILE}")
    message(STATUS "SKIP_SOURCE_DATA: Stage the original public Gille LabDCT file or configure SIMPLNX_GILLE_LABDCT_EXAMPLE_FILE; see the example README.")
    return()
  endif()
endif()
if(NOT EXISTS "${RAW_DATA_FILE}" OR IS_DIRECTORY "${RAW_DATA_FILE}")
  message(FATAL_ERROR "Configured Gille LabDCT source is missing or not a file: ${RAW_DATA_FILE}")
endif()
file(READ "${EXAMPLE_DIR}/DataSources.json" sources)
string(JSON filename GET "${sources}" files 0 filename)
string(JSON expected_hash GET "${sources}" files 0 sha256)
file(SHA256 "${RAW_DATA_FILE}" actual_hash)
if(NOT actual_hash STREQUAL expected_hash)
  message(FATAL_ERROR "Gille LabDCT source SHA256 mismatch: ${RAW_DATA_FILE}")
endif()
prepare_example_workspace()
file(REAL_PATH "${WORK_DIR}" work_root)
set(data_dir "${work_root}/Data/${OUTPUT_CATEGORY}")
file(MAKE_DIRECTORY "${data_dir}")
file(REAL_PATH "${data_dir}" data_real)
cmake_path(IS_PREFIX work_root "${data_real}" NORMALIZE data_inside)
set(staged_input "${data_real}/${filename}")
if(NOT data_inside OR IS_SYMLINK "${staged_input}" OR IS_DIRECTORY "${staged_input}")
  message(FATAL_ERROR "Unsafe Gille LabDCT staging path: ${staged_input}")
endif()
file(COPY_FILE "${RAW_DATA_FILE}" "${staged_input}" ONLY_IF_DIFFERENT)
run_example_pipeline_chain()
