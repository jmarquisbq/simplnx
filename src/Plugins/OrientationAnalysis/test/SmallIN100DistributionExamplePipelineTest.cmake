include("${CMAKE_CURRENT_LIST_DIR}/../../../../cmake/RunExamplePipelineChain.cmake")
set(OUTPUT_CATEGORY "Small_IN100_Distribution_Examples")
set(pipeline_stems "(01) Small IN100 Boundary Distribution Comparison")
validate_companion("${EXAMPLE_DIR}/${pipeline_stems}.d3dpipeline")
prepare_example_workspace()
file(REAL_PATH "${WORK_DIR}" work_root)
file(READ "${EXAMPLE_DIR}/DataSources.json" sources)
string(JSON filename GET "${sources}" files 0 filename)
string(JSON member GET "${sources}" files 0 archive_path)
string(JSON expected_hash GET "${sources}" files 0 sha256)
string(JSON archive_name GET "${sources}" archives 0 archive)
string(JSON archive_hash GET "${sources}" archives 0 sha512)
if(NOT filename STREQUAL "compute_gbcd_metric_based.dream3d" OR
   NOT member STREQUAL "compute_gbcd_metric_based/compute_gbcd_metric_based.dream3d" OR
   NOT archive_name STREQUAL "compute_gbcd_metric_based.tar.gz")
  message(FATAL_ERROR "Unexpected Small IN100 distribution source manifest")
endif()
if(DEFINED RAW_DATA_FILE AND NOT "${RAW_DATA_FILE}" STREQUAL "")
  set(input_path "${RAW_DATA_FILE}")
  if(NOT EXISTS "${input_path}" OR IS_DIRECTORY "${input_path}")
    message(FATAL_ERROR "Configured Small IN100 distribution input is missing: ${input_path}")
  endif()
else()
  set(archive_path "${ARCHIVE_DATA_DIR}/${archive_name}")
  if(NOT DEFINED ARCHIVE_DATA_DIR OR NOT EXISTS "${archive_path}")
    message(FATAL_ERROR "Supply RAW_DATA_FILE or ARCHIVE_DATA_DIR containing ${archive_name}; see the category README")
  endif()
  file(SHA512 "${archive_path}" actual_archive_hash)
  if(NOT actual_archive_hash STREQUAL archive_hash)
    message(FATAL_ERROR "Small IN100 distribution archive SHA512 mismatch: ${archive_path}")
  endif()
  set(extract_root "${work_root}/SourceArchive")
  file(MAKE_DIRECTORY "${extract_root}")
  file(REAL_PATH "${extract_root}" extract_real)
  cmake_path(IS_PREFIX work_root "${extract_real}" NORMALIZE extract_inside)
  if(NOT extract_inside)
    message(FATAL_ERROR "Archive extraction path is outside the test work directory: ${extract_real}")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${archive_path}" DESTINATION "${extract_real}" PATTERNS "${member}")
  set(input_path "${extract_real}/${member}")
endif()
file(SHA256 "${input_path}" actual_hash)
if(NOT actual_hash STREQUAL expected_hash)
  message(FATAL_ERROR "Small IN100 distribution member SHA256 mismatch: ${input_path}")
endif()
set(data_dir "${work_root}/Data/${OUTPUT_CATEGORY}")
file(MAKE_DIRECTORY "${data_dir}")
file(REAL_PATH "${data_dir}" data_real)
cmake_path(IS_PREFIX work_root "${data_real}" NORMALIZE data_inside)
if(NOT data_inside)
  message(FATAL_ERROR "Input staging directory is outside the work directory: ${data_real}")
endif()
set(staged_input "${data_real}/${filename}")
if(IS_SYMLINK "${staged_input}" OR IS_DIRECTORY "${staged_input}")
  message(FATAL_ERROR "Unsafe Small IN100 distribution staging file: ${staged_input}")
endif()
file(COPY_FILE "${input_path}" "${staged_input}" ONLY_IF_DIFFERENT)
run_example_pipeline_chain()
