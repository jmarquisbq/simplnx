include("${CMAKE_CURRENT_LIST_DIR}/../../../../cmake/RunExamplePipelineChain.cmake")
set(OUTPUT_CATEGORY "Vendor_EBSD_Import_Examples")
set(pipeline_stems "(01) Vendor EBSD Import Checks")
validate_companion("${EXAMPLE_DIR}/${pipeline_stems}.d3dpipeline")
prepare_example_workspace()
file(REAL_PATH "${WORK_DIR}" work_root)
file(READ "${EXAMPLE_DIR}/DataSources.json" sources)
set(data_dir "${work_root}/Data/${OUTPUT_CATEGORY}")
file(MAKE_DIRECTORY "${data_dir}")
file(REAL_PATH "${data_dir}" data_dir_real)
cmake_path(IS_PREFIX work_root "${data_dir_real}" NORMALIZE data_inside)
if(NOT data_inside)
  message(FATAL_ERROR "Vendor data staging directory is outside the work directory: ${data_dir_real}")
endif()
string(JSON file_count LENGTH "${sources}" files)
math(EXPR file_last "${file_count}-1")
foreach(index RANGE 0 ${file_last})
  string(JSON filename GET "${sources}" files ${index} filename)
  string(JSON member GET "${sources}" files ${index} archive_path)
  string(JSON archive_name GET "${sources}" files ${index} archive)
  string(JSON expected_file_hash GET "${sources}" files ${index} sha256)
  set(input_path "${RAW_DATA_DIR}/${filename}")
  if(NOT DEFINED RAW_DATA_DIR OR NOT EXISTS "${input_path}")
    set(archive_path "${ARCHIVE_DATA_DIR}/${archive_name}")
    if(NOT DEFINED ARCHIVE_DATA_DIR OR NOT EXISTS "${archive_path}")
      message(FATAL_ERROR "Missing ${filename}. Supply RAW_DATA_DIR with both original vendor exports, or ARCHIVE_DATA_DIR with the normal test-data archives; see the category README.")
    endif()
    set(expected_archive_hash "")
    string(JSON archive_count LENGTH "${sources}" archives)
    math(EXPR archive_last "${archive_count}-1")
    foreach(archive_index RANGE 0 ${archive_last})
      string(JSON candidate_name GET "${sources}" archives ${archive_index} archive)
      if(candidate_name STREQUAL archive_name)
        string(JSON expected_archive_hash GET "${sources}" archives ${archive_index} sha512)
      endif()
    endforeach()
    file(SHA512 "${archive_path}" actual_archive_hash)
    if(NOT actual_archive_hash STREQUAL expected_archive_hash)
      message(FATAL_ERROR "Vendor source archive SHA512 mismatch: ${archive_path}")
    endif()
    set(extract_root "${work_root}/SourceArchives/${archive_name}")
    file(MAKE_DIRECTORY "${extract_root}")
    file(REAL_PATH "${extract_root}" extract_real)
    cmake_path(IS_PREFIX work_root "${extract_real}" NORMALIZE extract_inside)
    if(NOT extract_inside)
      message(FATAL_ERROR "Archive extraction directory is outside the work directory: ${extract_real}")
    endif()
    file(ARCHIVE_EXTRACT INPUT "${archive_path}" DESTINATION "${extract_real}" PATTERNS "${member}")
    set(input_path "${extract_real}/${member}")
  endif()
  file(SHA256 "${input_path}" actual_file_hash)
  if(NOT actual_file_hash STREQUAL expected_file_hash)
    message(FATAL_ERROR "Vendor source SHA256 mismatch: ${input_path}")
  endif()
  set(staged_input "${data_dir_real}/${filename}")
  if(IS_SYMLINK "${staged_input}" OR IS_DIRECTORY "${staged_input}")
    message(FATAL_ERROR "Unsafe vendor input staging path: ${staged_input}")
  endif()
  file(COPY_FILE "${input_path}" "${staged_input}" ONLY_IF_DIFFERENT)
endforeach()
run_example_pipeline_chain()
