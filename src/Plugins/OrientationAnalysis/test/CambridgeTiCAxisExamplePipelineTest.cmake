include("${CMAKE_CURRENT_LIST_DIR}/../../../../cmake/RunExamplePipelineChain.cmake")
set(OUTPUT_CATEGORY "Cambridge_Ti_CAxis_Examples")
set(pipeline_stems
  "(01) Cambridge Ti Import and C-Axis Directions"
  "(02) Cambridge Ti Grain C-Axis Metrics"
  "(03) Cambridge Ti C-Axis Grouping Comparison"
)
foreach(stem IN LISTS pipeline_stems)
  validate_companion("${EXAMPLE_DIR}/${stem}.d3dpipeline")
endforeach()
prepare_example_workspace()
file(REAL_PATH "${WORK_DIR}" work_root)
set(data_dir "${work_root}/Data/CambridgeTitanium")
file(MAKE_DIRECTORY "${data_dir}")
file(REAL_PATH "${data_dir}" resolved_data_dir)
cmake_path(IS_PREFIX work_root "${resolved_data_dir}" NORMALIZE data_inside)
if(NOT data_inside)
  message(FATAL_ERROR "Input staging directory must stay in the test workspace: ${resolved_data_dir}")
endif()

file(READ "${EXAMPLE_DIR}/DataSources.json" sources)
string(JSON file_count LENGTH "${sources}" files)
string(JSON relative_directory GET "${sources}" relative_directory)
if(NOT file_count EQUAL 2 OR NOT relative_directory STREQUAL "Data/CambridgeTitanium")
  message(FATAL_ERROR "Expected the declared Cambridge titanium CPR/CRC pair")
endif()
get_filename_component(runtime_dir "${NXRUNNER}" DIRECTORY)
set(missing_inputs "")
foreach(index RANGE 0 1)
  string(JSON filename GET "${sources}" files ${index} filename)
  string(JSON member GET "${sources}" files ${index} archive_path)
  string(JSON expected_hash GET "${sources}" files ${index} sha512)
  if(NOT filename MATCHES "^[A-Za-z0-9_-]+[.](cpr|crc)$" OR NOT member STREQUAL "upload_scripts_apollo/${filename}")
    message(FATAL_ERROR "Invalid source archive member: ${member}")
  endif()
  set(input_path "${resolved_data_dir}/${filename}")
  set(cache_path "${runtime_dir}/Data/CambridgeTitanium/${filename}")
  if(IS_SYMLINK "${input_path}" OR IS_DIRECTORY "${input_path}")
    message(FATAL_ERROR "Unsafe input staging path: ${input_path}")
  endif()
  if(EXISTS "${input_path}")
    file(SHA512 "${input_path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Staged input checksum mismatch: ${input_path}")
    endif()
  elseif(EXISTS "${cache_path}")
    file(SHA512 "${cache_path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Cached input checksum mismatch: ${cache_path}")
    endif()
    file(COPY_FILE "${cache_path}" "${input_path}")
  else()
    list(APPEND missing_inputs ${index})
  endif()
endforeach()

# Fetch the published archive only when the pair is absent from local input caches.
if(NOT "${missing_inputs}" STREQUAL "")
  string(JSON archive_url GET "${sources}" archive url)
  string(JSON archive_hash GET "${sources}" archive sha512)
  set(archive_path "${resolved_data_dir}/upload_scripts_apollo.zip")
  if(IS_SYMLINK "${archive_path}" OR IS_DIRECTORY "${archive_path}")
    message(FATAL_ERROR "Unsafe source archive path: ${archive_path}")
  endif()
  if(EXISTS "${archive_path}")
    file(SHA512 "${archive_path}" actual_hash)
    if(NOT actual_hash STREQUAL archive_hash)
      message(FATAL_ERROR "Source archive checksum mismatch: ${archive_path}")
    endif()
  else()
    set(download_path "${archive_path}.download")
    if(IS_SYMLINK "${download_path}" OR IS_DIRECTORY "${download_path}")
      message(FATAL_ERROR "Unsafe temporary archive path: ${download_path}")
    endif()
    file(DOWNLOAD "${archive_url}" "${download_path}"
      EXPECTED_HASH "SHA512=${archive_hash}" TLS_VERIFY ON TIMEOUT 300)
    file(RENAME "${download_path}" "${archive_path}")
  endif()
  set(extract_dir "${resolved_data_dir}/archive")
  file(MAKE_DIRECTORY "${extract_dir}")
  file(REAL_PATH "${extract_dir}" resolved_extract_dir)
  cmake_path(IS_PREFIX resolved_data_dir "${resolved_extract_dir}" NORMALIZE extract_inside)
  if(NOT extract_inside)
    message(FATAL_ERROR "Archive extraction must stay below the input directory: ${resolved_extract_dir}")
  endif()
  foreach(index IN LISTS missing_inputs)
    string(JSON filename GET "${sources}" files ${index} filename)
    string(JSON member GET "${sources}" files ${index} archive_path)
    string(JSON expected_hash GET "${sources}" files ${index} sha512)
    file(ARCHIVE_EXTRACT INPUT "${archive_path}" DESTINATION "${resolved_extract_dir}" PATTERNS "${member}")
    file(SHA512 "${resolved_extract_dir}/${member}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Extracted input checksum mismatch: ${member}")
    endif()
    file(COPY_FILE "${resolved_extract_dir}/${member}" "${resolved_data_dir}/${filename}")
  endforeach()
endif()
run_example_pipeline_chain()
