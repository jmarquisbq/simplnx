include("${CMAKE_CURRENT_LIST_DIR}/../../../../cmake/RunExamplePipelineChain.cmake")
set(OUTPUT_CATEGORY "OIM_Nickel_Pattern_Examples")
set(pipeline_stems "(01) OIM Nickel Pattern Inspection")
foreach(stem IN LISTS pipeline_stems)
  validate_companion("${EXAMPLE_DIR}/${stem}.d3dpipeline")
endforeach()
prepare_example_workspace()
get_filename_component(runtime_dir "${NXRUNNER}" DIRECTORY)
if(NOT DEFINED RAW_DATA_FILE)
  set(RAW_DATA_FILE "${runtime_dir}/Data/OrientationAnalysis/EdaxOIMData.h5")
endif()
if(NOT EXISTS "${RAW_DATA_FILE}" OR IS_DIRECTORY "${RAW_DATA_FILE}")
  message(FATAL_ERROR "Missing official OIM sample: ${RAW_DATA_FILE}. Supply RAW_DATA_FILE or stage Data/OrientationAnalysis/EdaxOIMData.h5; see the category README.")
endif()
file(READ "${EXAMPLE_DIR}/DataSources.json" sources)
string(JSON expected_hash GET "${sources}" files 0 sha256)
file(SHA256 "${RAW_DATA_FILE}" input_hash)
if(NOT input_hash STREQUAL expected_hash)
  message(FATAL_ERROR "OIM sample SHA256 mismatch: ${RAW_DATA_FILE}")
endif()
file(REAL_PATH "${WORK_DIR}" work_root)
set(data_dir "${work_root}/Data/OrientationAnalysis")
file(MAKE_DIRECTORY "${data_dir}")
file(REAL_PATH "${data_dir}" resolved_data_dir)
cmake_path(IS_PREFIX work_root "${resolved_data_dir}" NORMALIZE data_inside)
set(staged_input "${resolved_data_dir}/EdaxOIMData.h5")
if(NOT data_inside OR IS_SYMLINK "${staged_input}" OR IS_DIRECTORY "${staged_input}")
  message(FATAL_ERROR "Unsafe OIM sample staging path: ${staged_input}")
endif()
file(COPY_FILE "${RAW_DATA_FILE}" "${staged_input}" ONLY_IF_DIFFERENT)
run_example_pipeline_chain()
# Detect truncated or misordered raw detector exports without Python dependencies.
set(raw_output "${work_root}/Data/Output/${OUTPUT_CATEGORY}/Inspection/Pattern.bin")
file(SIZE "${raw_output}" raw_size)
file(SHA256 "${raw_output}" raw_hash)
if(NOT raw_size EQUAL 7200 OR NOT raw_hash STREQUAL "3bb5537eda525095b25f26df9f55377b71eef94b2aa13b01f64be4d44cedd783")
  message(FATAL_ERROR "Selected Pattern.bin must contain the exact two measured 60 by 60 uint8 patterns in source order")
endif()
